<Mod>	
	<Name>SpecialEffects</Name>
	<Author>wizz6rd</Author>
	<Version>0.4.0</Version>
	
	<Description>
	Adds: SpotLight, Glass, ParticleEmitter, and Text blocks. Spot light entity is not fully implemented, just testing things. Other blocks will come in the future to add special effects in game.
	</Description>
	
	<Icon name="SpecialEffects_icon" />
	<Debug>false</Debug>
	<MultiplayerCompatible>true</MultiplayerCompatible>

	<Assemblies>
		<Assembly path="SpecialEffectsAssembly.dll" />
	</Assemblies>

	<Blocks>
		<Block path="SpotLight.xml" />
		<Block path="GlassBlock.xml" />
		<Block path="ParticleEmitter.xml" />
		<Block path="TextBlock.xml" />
	</Blocks>

	<Entities>
		<Entity path="SpotLightEntity.xml" />
	</Entities>
	
	<Events>
		<Event>
			<Name>SpotLight</Name>
			<ID>1</ID>
			<Icon name="SpecialEffects_icon" />
			<Properties>
				<Choice name="LightTypeInput" default="0">
					<Option index="0">Spot</Option>
					<Option index="1">Directional</Option>
					<Option index="2">Point</Option>
				</Choice>
				<NumberInput name="BrightnessInput" title="Brightness" default="50" suffix="%" maxValue="100" minValue="0" />
				<TextInput name="ColorInput" title="Color" default="#FF0000" />
				<NumberInput name="AngleInput" title="Angle" suffix="°" default="65" negativeNumbers="false" maxValue="180" minValue="0" />
				<NumberInput name="RangeInput" title="Range" suffix="m" default="30" negativeNumbers="false" maxValue="1000" minValue="0" />
				<Choice name="IlluminationTypeInput" default="0">
					<Option index="0">Pixel</Option>
					<Option index="1">Vertex</Option>
					<Option index="2">Auto</Option>
				</Choice>
				<Toggle name="HideVisuals" default="false">
					<Icon name="SpecialEffects_icon" />
				</Toggle>

			</Properties>
		</Event>
	</Events>
	
